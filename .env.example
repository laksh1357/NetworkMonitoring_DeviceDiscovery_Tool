# Deployment ports
API_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# Required for authenticated live API access. Use a unique 16+ character value.
LAN_WATCHTOWER_ADMIN_PASSWORD=

# TCP decoys are opt-in and record connection metadata only.
LAN_WATCHTOWER_HONEYPOT_ENABLED=false
LAN_WATCHTOWER_HONEYPOT_BIND=127.0.0.1
LAN_WATCHTOWER_HONEYPOT_PORTS=

# Keep the API deployment single-process. Do not run monitoring schedulers in
# multiple web workers.
WEB_CONCURRENCY=1
WEBSOCKET_ENABLED=false

# Notification providers. Leave disabled unless explicitly configured.
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=
WEBHOOK_URL=
