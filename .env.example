# Deployment ports
API_PORT=8000
FRONTEND_PORT=8080

# Keep the API deployment single-process. Do not run monitoring schedulers in
# multiple web workers.
WEB_CONCURRENCY=1
WEBSOCKET_ENABLED=false

# Notification providers. Leave disabled unless explicitly configured.
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=
WEBHOOK_URL=
